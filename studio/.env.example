SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production

# Live preview iframe target (the Nuxt site URL)
SANITY_STUDIO_PREVIEW_URL=https://train321-marketing.vercel.app

# LMS API the course dropdowns (Enroll ID, Enrollment Page → Courses to
# offer) read their list from. Leave unset for production; set to a local
# backend (e.g. http://127.0.0.1:8000) so a local Studio lists local courses.
SANITY_STUDIO_LMS_API_URL=

# Pexels stock-photo search in the image picker. Free key from
# https://www.pexels.com/api/ — exposed in the Studio bundle (all
# SANITY_STUDIO_* vars are), so use a key dedicated to this Studio.
SANITY_STUDIO_PEXELS_API_KEY=
