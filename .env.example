# Local dev: optional. Pages read from /content directly via lib/content.ts.
# These env vars are only needed when wiring TinaCMS's editor backend
# (which adds visual editing). Without them, the site still builds and serves
# all content correctly.

# Public site URL (used by Next metadata, sitemap)
SITE_URL=https://train321-marketing.vercel.app

# Where the LMS app lives (Sign In and Enroll buttons link here)
NEXT_PUBLIC_APP_BASE=https://lms.train321.com

# Train321 platform API (for live pricing/seat data, future)
API_BASE=https://api.train321.com

# ── TinaCMS editor backend (optional, leave blank for now) ─────────────────
# Required ONLY when running the Tina editor in production. For local dev
# the editor reads/writes the filesystem directly.
#
# To enable editor mode:
# 1. Sign up at https://app.tina.io/ (free tier covers solo use)
# 2. Create a project, paste the IDs below
# 3. Or: self-host the backend per https://tina.io/docs/self-hosted/

NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
TINA_SEARCH_TOKEN=
