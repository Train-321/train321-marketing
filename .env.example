# ── Site config ──────────────────────────────────────────────────────────
SITE_URL=https://train321-marketing.vercel.app
NEXT_PUBLIC_APP_BASE=https://lms.train321.com
API_BASE=https://api.train321.com

# ── TinaCMS local dev ────────────────────────────────────────────────────
# Set TINA_PUBLIC_IS_LOCAL=true to skip the production backend (MongoDB +
# GitHub) and use Tina's local filesystem mode instead. The npm scripts
# `dev` and `build:local` already set this for you. Only override if you
# want to run the full self-hosted stack against a local MongoDB.
TINA_PUBLIC_IS_LOCAL=true

# ── TinaCMS self-hosted production ───────────────────────────────────────
# Required ONLY for production deployments. Leave blank for local dev.
# Setup steps in README.md → "Editor mode (self-hosted)".

# MongoDB connection string. Use MongoDB Atlas free tier — sign up at
# https://www.mongodb.com/cloud/atlas and create an M0 cluster. Copy the
# connection string and paste below. Remember to allow Vercel's IPs (or
# 0.0.0.0/0 for the simplest path) in Atlas Network Access.
MONGODB_URI=

# GitHub fine-grained PAT with Contents: Read+Write on Train-321/train321-marketing.
# Create at https://github.com/settings/tokens?type=beta
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_OWNER=Train-321
GITHUB_REPO=train321-marketing
# Optional, defaults to "main"
# GITHUB_BRANCH=main

# Random 32+ char string for NextAuth session cookies.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://train321-marketing.vercel.app
