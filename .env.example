# Sanity (get these from https://sanity.io/manage after creating a project)
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production

# Token for Sanity reads (drafts) and the import script's writes.
# For production, prefer a Viewer token here and use a separate write token only locally.
# Generate at https://sanity.io/manage/project/<id>/api → Tokens
SANITY_WRITE_TOKEN=

# Studio origin for visual editing — change in production (e.g. https://studio.train321.com)
SANITY_STUDIO_URL=http://localhost:3333

# Your existing app's API (for live data: pricing, course catalog, etc.)
API_BASE=https://api.train321.com

# Where the LMS app lives (Sign In and Enroll buttons link here)
APP_BASE=https://app.train321.com

# The marketing site's public URL (used for sitemap, OG tags, canonical URLs)
SITE_URL=https://train321.com
